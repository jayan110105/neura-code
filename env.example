DATABASE_URL=<YOUR_DATABASE_URL>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GOOGLE_API_KEY=
OPENAI_API_KEY=
CRON_SECRET_TOKEN=your-secret-token-here
